// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



/// Per-slide image state, so one slide can be re-illustrated on its own
enum SlideImageStatus {
  READY
  GENERATING
  FAILED
}

/// Per-slide text state, so one slide can be rewritten from feedback on its own
enum SlideTextStatus {
  READY
  REWRITING
  FAILED
}

enum DeckStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

model Deck {
  id           String     @id @default(cuid())
  /// Clerk user id — every deck belongs to exactly one signed-in user
  userId       String
  idea         String     @db.Text
  title        String?
  status       DeckStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  slides       Slide[]

  @@index([userId])
}

model Slide {
  id          String   @id @default(cuid())
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  content     String   @db.Text
  imagePrompt String   @db.Text
  imageUrl    String?
  imageStatus SlideImageStatus @default(READY)
  textStatus  SlideTextStatus  @default(READY)
  createdAt   DateTime @default(now())
  notes       SlideNote[]

  @@index([deckId])
}

/// Feedback captured on one slide, usually while presenting to a room.
/// An empty body is a quick flag — "come back to this slide" — filled in later.
model SlideNote {
  id        String   @id @default(cuid())
  slideId   String
  slide     Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)
  body      String   @default("") @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([slideId])
}