PORT=4000

# Clerk authentication — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# PostgreSQL (local, Neon, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_pitch_deck?schema=public"

# Inngest — INNGEST_DEV=1 for local dev; remove it and set the keys in production
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ImageKit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# OpenAI — used by the pitch deck agent and slide image generation
OPENAI_API_KEY=
# true = free stock photos instead of OpenAI images (for local testing)
USE_PLACEHOLDER_IMAGES=false

# Per-user spend limits. Invalid values are ignored and the defaults below are used.
# Counts reset on UTC midnight (images, rewrites) and the 1st of the month (decks).
# Deleting a deck does not refund the monthly deck — the OpenAI call already happened.
QUOTA_DECKS_PER_MONTH=5
QUOTA_MAX_CONCURRENT_DECKS=1
QUOTA_IMAGES_PER_DAY=30
QUOTA_REWRITES_PER_DAY=30

# Comma-separated origins allowed to call this API from a browser.
# Production: your Vercel URL, e.g. https://ai-pitch-deck.vercel.app (no trailing slash).
# Leave empty locally — the Vite dev proxy makes the browser see one origin.
FRONTEND_ORIGIN=
